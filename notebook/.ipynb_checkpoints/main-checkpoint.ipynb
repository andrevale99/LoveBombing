    "# Modelo exponencial crescente com assíntota\n",
    "def modelo(x, A, B, C):\n",
    "    return A * np.exp(B * x) + C\n",
    "\n",
    "\n",
    "# Chute inicial\n",
    "p0 = [10.0, 0.01, -10.0]\n",
    "\n",
    "\n",
    "# Ajuste\n",
    "param, cov = curve_fit(\n",
    "    modelo,\n",
    "    pwm,\n",
    "    pressao,\n",
    "    p0=p0,\n",
    "    maxfev=10000\n",
    ")\n",
    "\n",
    "\n",
    "A, B, C = param\n",
    "\n",
    "\n",
    "print(f\"A = {A:.6f}\")\n",
    "print(f\"B = {B:.6f}\")\n",
    "print(f\"C = {C:.6f}\")\n",
    "\n",
    "\n",
    "# Valores estimados pelo modelo\n",
    "pressao_pred = modelo(pwm, *param)\n",
    "\n",
    "\n",
    "# R²\n",
    "ss_res = np.sum((pressao - pressao_pred) ** 2)\n",
    "ss_tot = np.sum((pressao - np.mean(pressao)) ** 2)\n",
    "\n",
    "r2 = 1 - (ss_res / ss_tot)\n",
    "\n",
    "\n",
    "print(f\"R² = {r2:.5f}\")\n",
    "\n",
    "\n",
    "# Gráfico\n",
    "x_plot = np.linspace(pwm.min(), pwm.max(), 500)\n",
    "y_plot = modelo(x_plot, *param)\n",
    "\n",
    "\n",
    "plt.figure(figsize=(6, 4))\n",
    "\n",
    "plt.scatter(\n",
    "    pwm,\n",
    "    pressao,\n",
    "    label=\"Dados\"\n",
    ")\n",
    "\n",
    "plt.plot(\n",
    "    x_plot,\n",
    "    y_plot,\n",
    "    label=f\"Ajuste\"\n",
    ")\n",
    "\n",
    "plt.xlabel(r'PWM ($\\%$)')\n",
    "plt.ylabel(r'Pressão (kPa)')\n",
    "\n",
